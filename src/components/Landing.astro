---
import { Content } from '../../aboutme.md';

// `start` is the view the page opens on: the home view or the about view.
const { start } = Astro.props;
const intro = 'Swiss, 26 years old';
const roles = ['Computational Biologist', 'ML Engineer', 'Software Engineer'];
---

<canvas class="waves" aria-hidden="true"></canvas>
<p class="caption">Chinese hibiscus &ndash; <i>Hibiscus rosa-sinensis</i></p>
<div class="band">
	<div class="scene home">
		<h1 id="name">Michael Jopiti</h1>
		<p id="intro" class="line">
			<span class="sr-only">{intro}</span>
			<span id="intro-text" aria-hidden="true">{intro}</span>
		</p>
		<p id="role" class="line">
			<span class="sr-only">{roles.join(', ')}</span>
			<span id="role-text" aria-hidden="true">{roles[0]}</span>
		</p>
	</div>
	<div class="scene about">
		<article><Content /></article>
	</div>
</div>
<!-- gives the page its scroll distance, everything visible is fixed -->
<div class="spacer"></div>

<!-- define:vars would stamp --p onto each element here and hide the value the script sets on the root -->
<style is:global set:html={`:root { --p: ${start === 'about' ? 1 : 0}; }`}></style>
<style is:global>
	html {
		/* keeps the width the same while the page is locked during a glide */
		scrollbar-gutter: stable;
	}
	body {
		/* the + grid is only for the other pages */
		background-image: none;
	}
	main {
		max-width: none;
		padding: 0;
	}
	nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1;
		opacity: clamp(0, calc(1 - var(--p) * 4), 1);
		transform: translateY(calc(var(--p) * -100%));
		/* white halo keeps the links readable over the waves */
		text-shadow: 0 0 6px #fff, 0 0 12px #fff;
	}
	/* black strip across the bottom, it grows to fill the screen as --p goes from 0 to 1 */
	.band {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: calc((33.333 + 66.667 * var(--p)) * 1vh);
		overflow: hidden;
		background: #000;
		color: #fff;
		text-shadow: none;
	}
	.scene {
		position: absolute;
		inset: 0;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		/* line the text up with the page content, which is centered in 60rem */
		padding: 0 max(1.5rem, calc((100vw - 60rem) / 2 + 1.5rem));
	}
	.home {
		opacity: clamp(0, calc(1 - (var(--p) - 0.55) * 4), 1);
	}
	.about {
		opacity: clamp(0, calc((var(--p) - 0.7) * 4), 1);
	}
	.waves {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.spacer {
		height: 180vh;
	}
	article {
		max-width: 40rem;
		line-height: 1.5;
	}
</style>


<!-- inline: runs right after the markup, so the full text never flashes before typing starts -->
<script is:inline define:vars={{ intro, roles, start }}>
	if (start === 'home' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
		const h1 = document.getElementById('name');
		const introText = document.getElementById('intro-text');
		const roleText = document.getElementById('role-text');
		const text = h1.textContent;

		h1.setAttribute('aria-label', text);
		h1.textContent = '';
		introText.textContent = '';
		roleText.textContent = '';

		// hidden letters keep their space, so the layout never shifts while typing
		const letters = [...text].map((char) => {
			const span = document.createElement('span');
			span.textContent = char;
			span.setAttribute('aria-hidden', 'true');
			span.style.visibility = 'hidden';
			h1.append(span);
			return span;
		});
		const caret = document.createElement('span');
		caret.className = 'caret';
		letters[0].before(caret);

		(async () => {
			await sleep(400);
			for (const span of letters) {
				span.style.visibility = 'visible';
				span.after(caret);
				await sleep(110 + Math.random() * 60);
			}

			introText.after(caret);
			await sleep(500);
			for (const char of intro) {
				introText.textContent += char;
				await sleep(70 + Math.random() * 50);
			}

			roleText.after(caret);
			await sleep(500);
			// type each title, hold it, erase it, then move to the next one forever
			for (let i = 0; ; i = (i + 1) % roles.length) {
				for (const char of roles[i]) {
					roleText.textContent += char;
					await sleep(70 + Math.random() * 50);
				}
				await sleep(1400);
				while (roleText.textContent) {
					roleText.textContent = roleText.textContent.slice(0, -1);
					await sleep(35);
				}
				await sleep(300);
			}
		})();
	}

	// Scrolling drives --p from 0 (home) to 1 (about). Everything else follows from it in CSS.
	{
		const root = document.documentElement;
		const nav = document.querySelector('nav');
		const home = document.querySelector('.scene.home');
		const about = document.querySelector('.scene.about');
		const range = () => innerHeight * 0.8;
		let shown = start;

		history.scrollRestoration = 'manual';

		function update() {
			const p = Math.min(1, Math.max(0, scrollY / range()));
			root.style.setProperty('--p', p);
			nav.style.visibility = p > 0.3 ? 'hidden' : '';
			home.inert = p > 0.7;
			about.inert = p < 0.7;

			// the address follows the view without loading anything
			const next = p > 0.7 ? 'about' : 'home';
			if (next !== shown) {
				shown = next;
				history.replaceState(null, '', next === 'about' ? '/about/' : '/');
				document.title = next === 'about' ? 'About Me' : 'Michael Jopiti';
			}
		}

		if (start === 'about') scrollTo(0, range());
		update();
		addEventListener('scroll', update, { passive: true });
		addEventListener('resize', update);

		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let settled = start === 'about' ? 1 : 0; // the view the page is in, 0 home, 1 about
		let animating = false;
		let samples = [];
		let pause;

		// Glide to a view. The page is locked meanwhile so leftover wheel or trackpad momentum
		// cannot fight the glide.
		function snapTo(target) {
			const from = scrollY;
			const to = target * range();
			settled = target;
			if (animating || Math.abs(from - to) <= 1) return;
			animating = true;
			root.style.overflow = 'hidden';
			const duration = reduced ? 0 : Math.min(900, 350 + Math.abs(to - from) * 0.4);
			const t0 = performance.now();
			const step = (now) => {
				const k = duration ? Math.min(1, (now - t0) / duration) : 1;
				scrollTo(0, from + (to - from) * (1 - (1 - k) ** 3));
				if (k < 1) return requestAnimationFrame(step);
				setTimeout(() => {
					root.style.overflow = '';
					animating = false;
					samples = [];
				}, 150);
			};
			step(t0);
		}

		// Magnet. Leaving a view takes 30% of the way, otherwise it pulls back. A fast flick
		// does not wait for that: if its momentum would carry it past the edge, it completes.
		// shortcut: momentum guessed as the last 100 ms speed times 250 ms, tune by feel.
		addEventListener(
			'scroll',
			() => {
				if (animating) return;
				const now = performance.now();
				samples.push({ t: now, y: scrollY });
				while (samples[0].t < now - 100) samples.shift();
				const speed = now > samples[0].t ? (scrollY - samples[0].y) / (now - samples[0].t) : 0; // px/ms
				const projected = (scrollY + speed * 250) / range();
				if (Math.abs(speed) > 0.4 && (settled ? projected < 0.7 : projected > 0.3)) {
					snapTo(1 - settled);
					return;
				}
				clearTimeout(pause);
				pause = setTimeout(() => {
					const p = scrollY / range();
					snapTo(settled ? (p < 0.7 ? 0 : 1) : p > 0.3 ? 1 : 0);
				}, 120);
			},
			{ passive: true },
		);

		// the About Me link glides to the about view instead of loading a page
		nav.querySelector('a[href="/about"]').addEventListener('click', (event) => {
			event.preventDefault();
			snapTo(1);
		});
	}
</script>

<!-- A single ASCII hibiscus: a bud that opens, then the flower stays and its ripples keep moving -->
<script is:inline>
	{
		const canvas = document.querySelector('canvas.waves');
		const ctx = canvas.getContext('2d');
		const nav = document.querySelector('nav');
		const CELL_W = 7;
		const CELL_H = 11;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const start = performance.now();

		function resize() {
			const dpr = Math.min(devicePixelRatio || 1, 2);
			canvas.width = innerWidth * dpr;
			canvas.height = innerHeight * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.font = 'bold 11px ui-monospace, Menlo, Consolas, monospace';
			ctx.textBaseline = 'middle';
			ctx.textAlign = 'center';
		}

		const clamp = (x) => Math.min(1, Math.max(0, x));
		const ease = (x) => 1 - (1 - clamp(x)) ** 3;
		const mix = (a, b, k) => a.map((c, n) => Math.round(c + (b[n] - c) * k));
		const ink = (rgb, alpha) => {
			ctx.fillStyle = `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, ${alpha})`;
		};
		// the line character that follows a direction, `angle` in radians with y pointing down
		const along = (angle) => ['-', '\\', '|', '/'][Math.round((((angle % Math.PI) + Math.PI) % Math.PI) / (Math.PI / 4)) % 4];

		// colors taken from the photos: crimson throat, pink bud, cream rim, yellow anthers, green calyx
		const CRIMSON = [168, 18, 62];
		const ROSE = [226, 70, 110];
		const PINK = [238, 140, 165];
		const BUD_LIGHT = [240, 212, 96]; // the bud's petals are yellow, like the open flower's rim
		const BUD_DARK = [214, 170, 52];
		const CREAM = [214, 192, 118];
		const VEIN = [188, 186, 198];
		const GREEN = [84, 132, 70];
		const LIGHT_GREEN = [128, 170, 100];
		const YELLOW = [244, 214, 70];
		const ORANGE = [226, 150, 18];

		// anthers on the staminal column, fixed so they do not jump around
		let seed = 5;
		const random = () => {
			seed = (seed + 0x6d2b79f5) | 0;
			let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
			t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
			return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
		};
		const ANTHERS = Array.from({ length: 56 }, () => ({
			t: 0.42 + random() * 0.5,
			side: random() * 2 - 1,
			char: random() < 0.5 ? 'o' : '@',
		}));

		// Timeline in seconds: 0.5-3 the bud swells, 3.5-10 it opens, then it stays. The flower
		// never moves as a whole, but its edges, veins and anthers keep drifting so it is never still.
		function draw(now) {
			const sec = reduced ? 99 : (now - start) / 1000;
			const wind = reduced ? 0 : sec; // 0 freezes every ripple
			ctx.clearRect(0, 0, innerWidth, innerHeight);

			// as big as the space between the nav and the strip allows, keeping some padding
			const pad = Math.max(24, innerHeight * 0.04);
			const top = nav.getBoundingClientRect().bottom + pad;
			const bottomEdge = innerHeight * 0.667 - pad;
			const hx = innerWidth / 2;
			const tipY = (top + bottomEdge) / 2; // centre of the flower
			const fullR = Math.max(60, (bottomEdge - top) / 2);

			const bud = ease((sec - 0.5) / 2.5);
			const open = ease((sec - 3.5) / 6.5);

			// head geometry: a bud is narrow and tall, an open flower is round with five petals
			const R = fullR * (0.38 * bud + 0.62 * open) * (1 + 0.012 * Math.sin(wind * 0.9));
			// the bud leans to the left and straightens up as it opens
			const lean = -0.3 * (1 - open);
			const cosLean = Math.cos(lean);
			const sinLean = Math.sin(lean);
			const sx = 0.62 + 0.38 * open;
			const sy = 1.55 - 0.55 * open;
			if (bud <= 0) return;

			// head, on a grid that moves with it so the characters stay put on the flower
			const cols = Math.ceil((fullR * 1.3) / CELL_W);
			const rows = Math.ceil((fullR * 1.3) / CELL_H);
			for (let j = -rows; j <= rows; j++) {
				for (let i = -cols; i <= cols; i++) {
					const dx = i * CELL_W;
					const dy = j * CELL_H;
					// the same cell in the bud's own, tilted, frame
					const rx = dx * cosLean + dy * sinLean;
					const ry = -dx * sinLean + dy * cosLean;
					const u = rx / sx;
					const v = ry / sy;
					// a closed bud is pointed at the top
					const height = Math.max(0, -v / (R * sy));
					const narrow = 1 - 0.55 * (1 - open) * height;
					const th = Math.atan2(v, u / narrow) + Math.PI / 2; // 0 points up
					const lobe = 0.5 + 0.5 * Math.cos(5 * th);
					// Wavy margin. The ripples come in multiples of five, two or three per petal, and
					// are much smaller than the notch, so moving them never changes the five petals.
					const ruffle = 0.04 * Math.sin(10 * th + 1.7 + wind * 0.9) + 0.02 * Math.sin(15 * th + 0.4 - wind * 0.7);
					// round petal tops with a deep notch between neighbours
					const reach = R * (1 - open * 0.3 * (1 - lobe ** 0.6)) * (1 + open * ruffle);
					const rho = Math.hypot(u / narrow, v) / reach;
					if (rho > 1) continue;
					const x = hx + dx;
					const y = tipY + dy;
					const down = v / (R * sy); // -1 at the top of the bud, 1 at the bottom

					// closed bud: green calyx round the lower part, pink twisted petals above
					if (open < 0.3) {
						if (down > -0.1 + open * 3) {
							ink(Math.floor(u / 6) % 3 === 0 ? GREEN : LIGHT_GREEN, 1);
							ctx.fillText(Math.floor(u / 6) % 3 === 0 ? '|' : ':', x, y);
						} else {
							const stripe = ((u * 0.8 + v) / 7) % 1;
							ink(stripe < 0.35 ? BUD_LIGHT : BUD_DARK, 1);
							ctx.fillText(stripe < 0.35 ? '/' : ':', x, y);
						}
						continue;
					}

					const o = ease((open - 0.3) / 0.7);
					// where this cell sits across its petal: 0 on the middle of the petal, 1 on the seam
					const turns = (5 * th) / (2 * Math.PI);
					const edge = 1 - Math.abs(2 * (((turns % 1) + 1) % 1) - 1);
					// crimson throat with rays, fading out into the petal
					// the throat points at the middle of each petal
					const rays = 0.5 + 0.5 * Math.cos(5 * th);
					const t = rho / (0.3 + 0.3 * rays ** 1.5);
					const c = (1 - t) * (0.7 + 0.3 * rays) * Math.min(1, o * 1.6);
					if (c > 0.06) {
						const glyph = c > 0.8 ? '@' : c > 0.6 ? '#' : c > 0.42 ? '%' : c > 0.28 ? '&' : c > 0.15 ? '*' : ':';
						ink(mix(PINK, CRIMSON, clamp(c * 1.2)), 1);
						ctx.fillText(glyph, x, y);
						continue;
					}
					// the rim of the petal, yellow while it unfolds and cream once open
					if (rho > 0.93) {
						ink(mix(BUD_LIGHT, CREAM, o), 1);
						ctx.fillText(along(Math.atan2(ry, rx) + Math.PI / 2), x, y);
						continue;
					}
					// a seam line between every two petals, straight out from the throat
					if (edge > 1 - 0.05 / (rho + 0.25) && rho > 0.28 && rho < 0.93) {
						ink([140, 138, 156], 1);
						ctx.fillText(along(Math.atan2(ry, rx)), x, y);
						continue;
					}
					// fine veins from the throat out, pink near the throat and grey further out
					// three veins per petal, the wind only bends them
					const vein = Math.abs(Math.sin(th * 15 + 1.3 * Math.sin(rho * 7 + wind * 0.4)));
					if (vein < 0.14) {
						ink(mix(ROSE, VEIN, clamp((rho - 0.3) / 0.4)), 0.75);
						ctx.fillText(along(Math.atan2(ry, rx)), x, y);
						continue;
					}
					// the body of the petal: lighter in the middle, heavier toward the seams, so each
					// petal reads as its own cushion
					const fold = clamp(0.9 * edge ** 1.5 + 0.1 * (0.5 + 0.5 * Math.sin(rho * 9 + wind * 0.3)));
					ink(mix(CREAM, VEIN, fold), 0.18 + 0.5 * fold);
					ctx.fillText(fold > 0.75 ? ';' : fold > 0.5 ? ':' : fold > 0.3 ? ',' : '.', x, y);
				}
			}

			// the staminal column curls up and to the left, anthers near its top, five stigmas at the tip
			const grow = ease((open - 0.6) / 0.4);
			if (grow > 0) {
				const at = (k) => ({
					x: hx + (0.04 * R - 0.4 * R * k + 0.06 * R * Math.sin(Math.PI * k)) * grow,
					y: tipY + (0.2 * R - 0.85 * R * k) * grow,
				});
				for (let k = 0; k <= 1; k += 0.035) {
					const point = at(k);
					ink(mix(CREAM, YELLOW, k), 1);
					ctx.fillText(k < 0.3 ? '|' : ':', point.x, point.y);
				}
				for (const a of ANTHERS) {
					const point = at(a.t);
					ink(ORANGE, 1);
					ctx.fillText(a.char, point.x + a.side * 0.1 * R * grow + 1.5 * Math.sin(wind * 1.1 + a.t * 20), point.y + a.side * 0.03 * R * grow + 1.5 * Math.cos(wind * 0.9 + a.side * 5));
				}
				const tip = at(1);
				ink(YELLOW, 1);
				for (const [dx, dy] of [[0, -1], [-1, 0], [1, 0], [0, 1], [0, 0]]) ctx.fillText('O', tip.x + dx * 7, tip.y + dy * 8 - 6);
			}
		}

		resize();
		addEventListener('resize', () => {
			resize();
			draw(performance.now());
		});
		draw(performance.now());

		if (!reduced) {
			let last = 0;
			const frame = (now) => {
				requestAnimationFrame(frame);
				// nothing to draw once the strip covers the screen
				if (now - last < 33 || scrollY > innerHeight * 0.8 * 0.98) return;
				last = now;
				draw(now);
			};
			requestAnimationFrame(frame);
		}
	}
</script>

<style>
	h1 {
		margin: 0;
		/* limited by height as well, so the three lines always fit inside the strip */
		font-size: clamp(2.5rem, min(12vw, 12vh), 9rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.04em;
	}
	.line {
		margin: 0.5rem 0 0;
		min-height: 1.3em;
		font-size: clamp(1.1rem, min(3.5vw, 3.5vh), 2.5rem);
		line-height: 1.3;
	}
	#intro {
		margin-top: 1.5rem;
	}
	/* zero-width space keeps the line box alive while the title is empty, so the caret stays on the line */
	.line::before {
		content: '\200b';
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	h1 :global(.caret),
	.line :global(.caret) {
		position: relative;
	}
	h1 :global(.caret)::after,
	.line :global(.caret)::after {
		content: '';
		position: absolute;
		left: 0.02em;
		bottom: 0.05em;
		width: 0.06em;
		height: 0.85em;
		background: currentColor;
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	/* small caption just right of center, under the flower, shown once it has opened */
	.caption {
		position: fixed;
		left: calc(50% + 2rem);
		bottom: calc(33.333vh + 0.9rem);
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: #555;
		animation: caption-in 1.5s ease 9s both;
	}
	@keyframes caption-in {
		from {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.caption {
			animation: none;
		}
	}
</style>
