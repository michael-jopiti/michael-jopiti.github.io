---
import Layout from '../layouts/Layout.astro';

const intro = 'Swiss, 26 years old';
const roles = ['Computational Biologist', 'ML Engineer', 'Software Engineer'];
---

<Layout title="Michael Jopiti">
	<h1 id="name">Michael Jopiti</h1>
	<p id="intro" class="line">
		<span class="sr-only">{intro}</span>
		<span id="intro-text" aria-hidden="true">{intro}</span>
	</p>
	<p id="role" class="line">
		<span class="sr-only">{roles.join(', ')}</span>
		<span id="role-text" aria-hidden="true">{roles[0]}</span>
	</p>
</Layout>

<!-- inline: runs right after the markup, so the full text never flashes before typing starts -->
<script is:inline define:vars={{ intro, roles }}>
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
		const h1 = document.getElementById('name');
		const introText = document.getElementById('intro-text');
		const roleText = document.getElementById('role-text');
		const text = h1.textContent;

		h1.setAttribute('aria-label', text);
		h1.textContent = '';
		introText.textContent = '';
		roleText.textContent = '';

		// hidden letters keep their space, so the layout never shifts while typing
		const letters = [...text].map((char) => {
			const span = document.createElement('span');
			span.textContent = char;
			span.setAttribute('aria-hidden', 'true');
			span.style.visibility = 'hidden';
			h1.append(span);
			return span;
		});
		const caret = document.createElement('span');
		caret.className = 'caret';
		letters[0].before(caret);

		(async () => {
			await sleep(400);
			for (const span of letters) {
				span.style.visibility = 'visible';
				span.after(caret);
				await sleep(110 + Math.random() * 60);
			}

			introText.after(caret);
			await sleep(500);
			for (const char of intro) {
				introText.textContent += char;
				await sleep(70 + Math.random() * 50);
			}

			roleText.after(caret);
			await sleep(500);
			// type each title, hold it, erase it, then move to the next one forever
			for (let i = 0; ; i = (i + 1) % roles.length) {
				for (const char of roles[i]) {
					roleText.textContent += char;
					await sleep(70 + Math.random() * 50);
				}
				await sleep(1400);
				while (roleText.textContent) {
					roleText.textContent = roleText.textContent.slice(0, -1);
					await sleep(35);
				}
				await sleep(300);
			}
		})();
	}
</script>

<style>
	h1 {
		margin: 20vh 0 0;
		font-size: clamp(3rem, 12vw, 9rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.04em;
	}
	.line {
		margin: 0.5rem 0 0;
		min-height: 1.3em;
		font-size: clamp(1.25rem, 3.5vw, 2.5rem);
		line-height: 1.3;
	}
	#intro {
		margin-top: 1.5rem;
	}
	/* zero-width space keeps the line box alive while the title is empty, so the caret stays on the line */
	.line::before {
		content: '\200b';
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	h1 :global(.caret),
	.line :global(.caret) {
		position: relative;
	}
	h1 :global(.caret)::after,
	.line :global(.caret)::after {
		content: '';
		position: absolute;
		left: 0.02em;
		bottom: 0.05em;
		width: 0.06em;
		height: 0.85em;
		background: currentColor;
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>
